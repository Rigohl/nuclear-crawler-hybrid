#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚦 Running pre-commit checks..."

# Format check (Rust)
echo "📝 Checking Rust format..."
cargo fmt -- --check
if [ $? -ne 0 ]; then
    echo "❌ Rust code not formatted. Run: cargo fmt"
    exit 1
fi

# Critical: 5 MCP tools test
echo "⚠️ Validating 5 MCP tools constraint..."
cargo test test_exactly_5_tools --lib --quiet
if [ $? -ne 0 ]; then
    echo "❌ CRITICAL: 5 MCP tools constraint VIOLATED!"
    exit 1
fi

# Check for mocks
echo "🚫 Checking for mock code..."
if grep -r "mock_\|Mock\|TODO: implement\|unimplemented!" src/; then
    echo "⚠️ WARNING: Potential mock code detected (NO MOCKS policy)"
    echo "Review and ensure all implementations are real"
fi

# Clippy
echo "🔍 Running Clippy..."
cargo clippy --quiet -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ Clippy found issues"
    exit 1
fi

echo "✅ All pre-commit checks passed!"
