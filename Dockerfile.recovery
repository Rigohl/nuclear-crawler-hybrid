FROM rust:1.75-slim as recovery-base

LABEL maintainer="Nuclear Crawler Team"
LABEL description="Model Recovery and Checkpoint Management System"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /recovery

# Copy checkpoint management scripts
COPY scripts/checkpoint_manager.py /recovery/
COPY scripts/validate_system.py /recovery/

# Make scripts executable
RUN chmod +x /recovery/*.py

# Install Python dependencies
RUN pip3 install --no-cache-dir pyyaml requests

# Default command: validate checkpoints
CMD ["python3", "/recovery/checkpoint_manager.py", "validate"]

# Usage examples:
# docker run nuclear-recovery backup
# docker run nuclear-recovery restore --timestamp 20240203_123456
# docker run nuclear-recovery validate
# docker run nuclear-recovery list
