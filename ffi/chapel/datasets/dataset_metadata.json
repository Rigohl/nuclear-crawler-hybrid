{
  "dataset_name": "chapel_ai_training_dataset",
  "version": "1.0.0",
  "created_at": "2026-01-23",
  "purpose": "Training data for Nuclear Chapel AI system",
  "total_samples": 81000,
  "splits": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1
  },
  "categories": {
    "information_search": {
      "name": "Information Search & Verification",
      "description": "Web search, source credibility, fake detection",
      "samples": 40500,
      "subcategories": {
        "fake_news_detection": {
          "samples": 20000,
          "red_flags": [
            "allegedly", "rumored", "unconfirmed", "anonymous",
            "sources say", "supposedly", "may have", "could have",
            "reported to", "some believe", "experts claim",
            "insider sources", "unnamed officials", "leaked documents",
            "according to sources", "allegedly leaked", "unverified reports",
            "controversial", "disputed", "questionable", "suspicious"
          ]
        },
        "credibility_scoring": {
          "samples": 12000,
          "sources": {
            "highly_credible": ["nature.com", "science.org", "ieee.org", "arxiv.org"],
            "credible": ["bbc.com", "nytimes.com", "wikipedia.org", "academic.edu"],
            "moderate": ["reddit.com", "medium.com", "quora.com", "github.com"],
            "low_credible": ["twitter.com", "facebook.com", "instagram.com", "tiktok.com"],
            "unverified": ["anonymous", "unknown", "rumor", "viral"]
          }
        },
        "multi_source_search": {
          "samples": 8500,
          "strategies": [
            "cross_reference",
            "consensus_check",
            "peer_review_verification",
            "citation_analysis",
            "publication_date_check"
          ]
        }
      }
    },
    "code_analysis": {
      "name": "Chapel Code Analysis & Repair",
      "description": "Static analysis, auto-fix, code review",
      "samples": 27000,
      "subcategories": {
        "static_analysis": {
          "samples": 10000,
          "metrics": [
            "cyclomatic_complexity",
            "lines_of_code",
            "token_count",
            "function_count",
            "code_smells",
            "duplicate_blocks"
          ]
        },
        "code_repair": {
          "samples": 10000,
          "pass_types": [
            "style_violations",
            "common_bugs",
            "performance_issues",
            "safety_checks"
          ]
        },
        "code_review": {
          "samples": 7000,
          "review_aspects": [
            "performance",
            "safety",
            "style",
            "complexity",
            "maintainability"
          ]
        }
      }
    },
    "configuration": {
      "name": "Configuration Management",
      "description": "Training params, system config, optimization",
      "samples": 13500,
      "subcategories": {
        "neural_network_config": {
          "samples": 5000,
          "parameters": {
            "layers": [10, 32, 5],
            "activation": "relu",
            "output_activation": "softmax",
            "optimizer": "adam",
            "learning_rates": [0.0001, 0.0005, 0.001, 0.005, 0.01],
            "batch_sizes": [32, 64, 128, 256],
            "epochs_range": [5, 10, 20, 50, 100]
          }
        },
        "parallel_config": {
          "samples": 4500,
          "strategies": [
            "blockdist",
            "cyclicdist",
            "replicated",
            "privatized"
          ],
          "locale_counts": [1, 2, 4, 8, 16]
        },
        "data_pipeline_config": {
          "samples": 4000,
          "batch_processing": [
            "sequential",
            "parallel",
            "distributed"
          ]
        }
      }
    }
  },
  "preprocessing": {
    "tokenization": {
      "method": "byte_pair_encoding",
      "vocab_size": 10000,
      "max_token_length": 32
    },
    "normalization": {
      "lowercase": true,
      "remove_special_chars": false,
      "remove_stopwords": false
    }
  },
  "quality_metrics": {
    "data_validation": {
      "null_check": true,
      "type_check": true,
      "range_check": true
    },
    "duplicate_removal": true,
    "outlier_detection": true
  },
  "augmentation": {
    "enabled": true,
    "techniques": [
      "synonym_replacement",
      "random_insertion",
      "random_swap",
      "random_deletion"
    ]
  }
}
