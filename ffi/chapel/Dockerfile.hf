# Chapel AI for HuggingFace Spaces
# Multi-stage build for maximum efficiency

FROM ubuntu:24.04 as builder

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    wget \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Chapel from binary
RUN cd /opt && \
    wget https://github.com/chapel-lang/chapel/releases/download/1.33.0/chapel-1.33.0.tar.gz && \
    tar xzf chapel-1.33.0.tar.gz && \
    cd chapel-1.33.0 && \
    ./configure --prefix=/opt/chapel && \
    make && make install

ENV CHAPEL_HOME=/opt/chapel
ENV PATH=$CHAPEL_HOME/bin:$PATH

# Final stage
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/chapel /opt/chapel

ENV CHAPEL_HOME=/opt/chapel
ENV PATH=$CHAPEL_HOME/bin:$PATH

WORKDIR /app

# Copy Chapel AI files
COPY ai/ /app/ai/
COPY tools/ /app/tools/
COPY training/ /app/training/
COPY Makefile /app/
COPY deploy_to_huggingface.py /app/

# Install Python dependencies
RUN pip install --no-cache-dir huggingface-hub

# Make deploy script executable
RUN chmod +x /app/deploy_to_huggingface.py

# Default: Deploy to HF
CMD ["python3", "/app/deploy_to_huggingface.py"]
