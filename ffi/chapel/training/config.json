{
  "model": {
    "name": "chatbot-continual-learning",
    "type": "transformer",
    "hidden_size": 768,
    "num_attention_heads": 12,
    "num_hidden_layers": 12,
    "intermediate_size": 3072,
    "vocab_size": 50257,
    "max_position_embeddings": 1024,
    "layer_norm_eps": 1e-12,
    "initializer_range": 0.02,
    "output_attentions": false,
    "output_hidden_states": false,
    "use_cache": true,
    "return_dict": true
  },
  "training": {
    "learning_rate": 5e-5,
    "weight_decay": 0.01,
    "adam_epsilon": 1e-8,
    "max_grad_norm": 1.0,
    "num_train_epochs": 3,
    "max_steps": -1,
    "warmup_steps": 0,
    "warmup_ratio": 0.1,
    "logging_steps": 100,
    "eval_steps": 500,
    "save_steps": 1000,
    "save_total_limit": 5,
    "seed": 42
  },
  "continual_learning": {
    "enabled": true,
    "experience_replay_size": 10000,
    "consolidation_threshold": 0.8,
    "rehearsal_ratio": 0.2,
    "task_buffer_size": 5000,
    "memory_update_frequency": 100,
    "plasticity_regularization": 0.1,
    "stability_coefficient": 1.0
  },
  "distributed": {
    "enabled": true,
    "backend": "nccl",
    "num_locales": 4,
    "tasks_per_locale": 1,
    "communication_pattern": "allreduce",
    "gradient_accumulation_steps": 4,
    "sync_every_n_steps": 100
  },
  "data": {
    "train_file": "data/train.json",
    "val_file": "data/val.json",
    "test_file": "data/test.json",
    "batch_size": 32,
    "eval_batch_size": 64,
    "max_seq_length": 512,
    "overwrite_cache": false,
    "num_workers": 4
  },
  "inference": {
    "max_new_tokens": 256,
    "temperature": 0.7,
    "top_k": 50,
    "top_p": 0.95,
    "repetition_penalty": 1.2,
    "num_beams": 1,
    "early_stopping": false
  },
  "checkpointing": {
    "checkpoint_dir": "checkpoints",
    "resume_from_checkpoint": null,
    "restore_state": true,
    "best_model_dir": "models/best",
    "latest_model_dir": "models/latest",
    "auto_resume": true
  },
  "logging": {
    "log_dir": "logs",
    "log_level": "INFO",
    "enable_tensorboard": true,
    "tensorboard_dir": "logs/tensorboard",
    "enable_wandb": false,
    "wandb_project": "nuclear-chatbot",
    "log_model": false
  }
}
