  "layer_2_quality_assessment": {
    "description": "Segunda capa: Evaluación de calidad + estandarización de datos",
    "total_patterns": 12000,
    "subpatterns": {
      
      "data_quality_metrics": {
        "samples_count": 3000,
        "pattern": {
          "metric": "Quality assessment",
          "quality_dimensions": {
            "completeness": {
              "description": "Percentage of required fields present",
              "threshold": 0.95,
              "weight": 0.2,
              "measurement": "count_filled_fields / total_required_fields"
            },
            "accuracy": {
              "description": "Data correctness validation",
              "threshold": 0.98,
              "weight": 0.25,
              "measurement": "regex_validation + type_checking"
            },
            "consistency": {
              "description": "Format and pattern consistency",
              "threshold": 0.97,
              "weight": 0.2,
              "measurement": "schema_conformity"
            },
            "timeliness": {
              "description": "Data freshness",
              "threshold": 0.9,
              "weight": 0.15,
              "measurement": "days_since_scrape"
            },
            "uniqueness": {
              "description": "Duplicate detection",
              "threshold": 0.95,
              "weight": 0.2,
              "measurement": "hash_collision_rate"
            }
          },
          "composite_quality_score": "weighted_average(all_dimensions)"
        }
      },

      "data_standardization": {
        "samples_count": 2500,
        "pattern": {
          "task": "Data normalization",
          "standardization_rules": {
            "text_normalization": {
              "rules": ["lowercase", "unicode_decompose", "whitespace_trim", "html_decode"],
              "quality_impact": 0.89
            },
            "url_normalization": {
              "rules": ["scheme_lowercase", "domain_lowercase", "sort_params", "remove_fragments"],
              "quality_impact": 0.95
            },
            "date_normalization": {
              "rules": ["iso8601_format", "timezone_utc", "validate_range"],
              "quality_impact": 0.98
            },
            "numeric_normalization": {
              "rules": ["parse_locale", "decimal_point_fix", "nan_handling"],
              "quality_impact": 0.92
            },
            "encoding_normalization": {
              "rules": ["detect_encoding", "convert_to_utf8", "validate_codepoints"],
              "quality_impact": 0.91
            }
          },
          "validation": "Applied to 100K records, 0.94 acceptance rate"
        }
      },

