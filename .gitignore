## 🎯 Custom Rules for Nuclear Crawler Hybrid
# Exclude large data files
*.data
*.bin
large_files/

# Exclude sensitive configuration
config/secrets.*
config/private.*

# Exclude development certificates
certs/dev/
certs/test/

# Keep important documentation
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!SECURITY.md

# Exclude IDE-specific files but keep shared configs
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.idea/codeStyles/
.idea/inspectionProfiles/

# Performance and debugging
debug.log
perf.log
memory.log

# Temporary MCP files
mcp_temp/
mcp_cache/
mcp_logs/

# Nuclear specific
nuclear_cache/
crawler_temp/
analysis_temp/

# End of .gitignore
go/
zig/
nim/

# Keep FFI WASM source files (real Go, Zig, Nim source code for WASM compilation)
!ffi/wasm/go/
!ffi/wasm/go/*.go
!ffi/wasm/zig/
!ffi/wasm/zig/*.zig
!ffi/wasm/nim/
!ffi/wasm/nim/*.nim
!ffi/wasm/build_wasm.sh

# Exclude compiled WASM binaries (build artifacts)
ffi/wasm/**/*.wasm
libs/
ffi/chapel/datasets/massive_training_120k.json

# Large ML models
*.safetensors
ffi/chapel/models/

# Keep only config, not the actual model
!ffi/chapel/models/*/config.json

