# ===========================================
# 🐳 CHAPEL HPC EDITOR - DOCKER CONTAINER
# ===========================================
# Contenedor con Chapel compiler oficial para edición paralela masiva

FROM chapel/chapel:latest

# Verificar que Chapel está funcionando
RUN chpl --version && echo "✅ Chapel compiler listo"

# Instalar herramientas adicionales para desarrollo
RUN apt-get update && apt-get install -y \
    vim \
    git \
    && rm -rf /var/lib/apt/lists/*

# Crear directorio de trabajo
WORKDIR /workspace

# Copiar archivos del proyecto
COPY . /workspace/

# Compilar la herramienta Chapel con optimizaciones HPC ultra-avanzadas
RUN echo "🔨 Compilando Chapel HPC Editor con optimizaciones extremas..." && \
    chpl \
    --fast \
    --specialize \
    --optimize-forall-unordered-ops \
    --optimize-loop-iterators \
    --optimize-on-clauses \
    --optimize-on \
    --inline \
    --vectorize \
    --cache-remote \
    --report-optimized-loop-iterators \
    chpl_parallel_editor.chpl \
    -o chpl_parallel_editor

# Verificar que se compiló correctamente
RUN ./chpl_parallel_editor --help || echo "❌ Error en compilación" && \
    ls -la chpl_parallel_editor && \
    echo "✅ Herramienta compilada exitosamente"

# Información del contenedor
RUN echo "🐳 Contenedor Chapel HPC Editor listo" && \
    echo "📊 Información del sistema:" && \
    uname -a && \
    echo "🟡 Chapel version:" && \
    chpl --version && \
    echo "💾 Espacio disponible:" && \
    df -h /workspace

# Comando por defecto
CMD ["/bin/bash"]