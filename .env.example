# Configuración de entorno para Nuclear Crawler Hybrid
# Copiar este archivo como .env y ajustar según sea necesario

# JARVIXSERVER - Backend de análisis e IA
JARVIX_URL=http://localhost:5050

# Nuclear MCP Server
NUCLEAR_MCP_PORT=8079

# TRAE CLI - Configuración
TRAE_PROJECT_PATH=.

# Configuración adicional (opcional)
# JARVIX_API_KEY=your_api_key_here
# LOG_LEVEL=info
