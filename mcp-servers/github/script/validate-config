#!/bin/sh
# Validate configuration and environment for github-mcp-server

set -e

ERRORS=0
WARNINGS=0

echo "🔍 Validating github-mcp-server configuration..."
echo ""

# Check if .env file exists
if [ -f .env ]; then
    echo "✅ .env file found"
    # Source .env to check variables (but don't export them)
    set -a
    . ./.env
    set +a
else
    echo "⚠️  .env file not found (optional, but recommended)"
    WARNINGS=$((WARNINGS + 1))
fi

# Check for required token
if [ -z "$GITHUB_PERSONAL_ACCESS_TOKEN" ]; then
    echo "❌ GITHUB_PERSONAL_ACCESS_TOKEN is not set"
    echo "   Create a token at: https://github.com/settings/personal-access-tokens/new"
    ERRORS=$((ERRORS + 1))
else
    # Basic token format validation
    if echo "$GITHUB_PERSONAL_ACCESS_TOKEN" | grep -qE '^(ghp_|gho_|ghu_|ghs_|ghr_)'; then
        echo "✅ GITHUB_PERSONAL_ACCESS_TOKEN is set (format looks valid)"
    else
        echo "⚠️  GITHUB_PERSONAL_ACCESS_TOKEN format may be invalid"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# Check Docker if GITHUB_HOST is set
if [ -n "$GITHUB_HOST" ]; then
    if echo "$GITHUB_HOST" | grep -qE '^https?://'; then
        echo "✅ GITHUB_HOST is set: $GITHUB_HOST"
    else
        echo "⚠️  GITHUB_HOST should start with http:// or https://"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# Check Go version
if command -v go >/dev/null 2>&1; then
    GO_VERSION=$(go version | awk '{print $3}' | sed 's/go//')
    REQUIRED_VERSION="1.24"
    if [ "$(printf '%s\n' "$REQUIRED_VERSION" "$GO_VERSION" | sort -V | head -n1)" = "$REQUIRED_VERSION" ]; then
        echo "✅ Go version $GO_VERSION is installed (>= $REQUIRED_VERSION required)"
    else
        echo "⚠️  Go version $GO_VERSION is installed, but >= $REQUIRED_VERSION is recommended"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo "⚠️  Go is not installed (required for local development)"
    WARNINGS=$((WARNINGS + 1))
fi

# Check Docker (optional, for containerized runs)
if command -v docker >/dev/null 2>&1; then
    echo "✅ Docker is installed"
    if docker info >/dev/null 2>&1; then
        echo "✅ Docker daemon is running"
    else
        echo "⚠️  Docker daemon is not running"
        WARNINGS=$((WARNINGS + 1))
    fi
else
    echo "ℹ️  Docker is not installed (optional, for containerized runs)"
fi

# Validate toolset configuration if set
if [ -n "$GITHUB_TOOLSETS" ]; then
    VALID_TOOLSETS="context,repos,issues,pull_requests,actions,code_security,dependabot,discussions,gists,git,labels,notifications,orgs,projects,secret_protection,security_advisories,stargazers,users,all,default"
    for toolset in $(echo "$GITHUB_TOOLSETS" | tr ',' ' '); do
        if echo "$VALID_TOOLSETS" | grep -qE "(^|,)$toolset(,|$)"; then
            echo "✅ Toolset '$toolset' is valid"
        else
            echo "❌ Toolset '$toolset' is not valid"
            ERRORS=$((ERRORS + 1))
        fi
    done
fi

# Summary
echo ""
if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo "✅ Configuration validation passed!"
    exit 0
elif [ $ERRORS -eq 0 ]; then
    echo "⚠️  Configuration validation passed with $WARNINGS warning(s)"
    exit 0
else
    echo "❌ Configuration validation failed with $ERRORS error(s) and $WARNINGS warning(s)"
    exit 1
fi
