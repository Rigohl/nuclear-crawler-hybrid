# GitHub MCP Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: GitHub Personal Access Token
# Create one at: https://github.com/settings/personal-access-tokens/new
# Minimum scopes: repo, read:packages, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=your_token_here

# Optional: GitHub Enterprise Server or Enterprise Cloud hostname
# For GitHub Enterprise Server: https://your-ghes-instance.com
# For GitHub Enterprise Cloud: https://your-org.ghe.com
# GITHUB_HOST=

# Optional: Toolset configuration
# Comma-separated list of toolsets to enable
# Default: context,repos,issues,pull_requests,users
# GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions

# Optional: Individual tools configuration
# Comma-separated list of specific tools to enable
# GITHUB_TOOLS=get_file_contents,issue_read,create_pull_request

# Optional: Read-only mode (1 = enabled, 0 = disabled)
# GITHUB_READ_ONLY=0

# Optional: Dynamic toolsets mode (1 = enabled, 0 = disabled)
# GITHUB_DYNAMIC_TOOLSETS=0

# Optional: Lockdown mode (1 = enabled, 0 = disabled)
# GITHUB_LOCKDOWN_MODE=0

# Optional: Insider mode for early access features (1 = enabled, 0 = disabled)
# GITHUB_INSIDER_MODE=0
